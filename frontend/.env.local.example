NEXT_PUBLIC_API_BASE_URL=https://workflow.example.com/api

# ── Local development only ──────────────────────────────────────────────────
# When developing directly against the backend (without Caddy), set both vars:
#
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#   NEXT_PUBLIC_DEV_ADMIN_TOKEN=<same value as ADMIN_API_TOKEN in your local .env>
#
# NEXT_PUBLIC_DEV_ADMIN_TOKEN is intentionally ignored at runtime when
# NODE_ENV=production, and the build will fail-fast if it is present in a
# production build (see next.config.mjs).
# Never set NEXT_PUBLIC_DEV_ADMIN_TOKEN in any production environment file.
