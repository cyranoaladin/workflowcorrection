# ============================================================
#  PRODUCTION ENVIRONMENT — math-correction-platform
#  Copy to .env and fill in every value marked ← REQUIRED
#  DO NOT commit .env to git (it is in .gitignore)
# ============================================================
#
# HOW TO GENERATE SECRETS
# ────────────────────────
# Random 40-char token (ADMIN_API_TOKEN, JWT_SECRET):
#   openssl rand -hex 40
#   python3 -c "import secrets; print(secrets.token_hex(40))"
#
# Random 24-char DB password (POSTGRES_PASSWORD):
#   openssl rand -hex 24
#
# Caddy bcrypt hash (CADDY_BASIC_AUTH_HASH) — run on the server:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-plaintext-password'
#   ⚠️  In docker-compose env files, escape every $ as $$
#       e.g.  $2a$14$abc...  →  $$2a$$14$$abc...
#
# DEPLOY COMMAND
# ──────────────
#   cp .env.production.example .env   # fill all ← REQUIRED values
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
#
# STARTUP VALIDATION
# ──────────────────
# The backend refuses to start in APP_ENV=production if any of these
# secrets look like placeholders (change_me / replace_with / example):
#   ADMIN_API_TOKEN (min 32 chars)
#   JWT_SECRET      (min 32 chars)
#   POSTGRES_PASSWORD (min 16 chars)
#   DATABASE_URL
#   CORS_ALLOWED_ORIGINS (must be HTTPS, no localhost)
#   PUBLIC_API_BASE_URL  (must be HTTPS, no localhost)
# ============================================================


# ── Domain & TLS (Caddy) ────────────────────────────────────
# Your public domain, e.g. workflow.yourdomain.com
APP_DOMAIN=workflow.example.com                                    # ← REQUIRED

# Email used by Caddy for Let's Encrypt TLS certificate
CADDY_ACME_EMAIL=admin@example.com                                 # ← REQUIRED

# Caddy Basic Auth — protects the web UI and all API routes
CADDY_BASIC_AUTH_USER=admin                                        # ← REQUIRED (choose a username)

# bcrypt hash of the plaintext password above
# Generate: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
# Escape $  →  $$ in this file
CADDY_BASIC_AUTH_HASH=$$2a$$14$$replace_with_caddy_bcrypt_hash     # ← REQUIRED


# ── Application ─────────────────────────────────────────────
APP_ENV=production
APP_NAME=math-correction-platform
APP_HOST=0.0.0.0
APP_PORT=8000

# Public API URL as seen by the browser (via Caddy /api/ prefix)
PUBLIC_API_BASE_URL=https://workflow.example.com/api               # ← REQUIRED (replace domain)
NEXT_PUBLIC_API_BASE_URL=https://workflow.example.com/api          # ← REQUIRED (same as above)


# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_DB=correction_db
POSTGRES_USER=correction_user

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_strong_database_password            # ← REQUIRED (min 16 chars)

# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above
DATABASE_URL=postgresql+psycopg2://correction_user:replace_with_strong_database_password@postgres:5432/correction_db  # ← REQUIRED


# ── Redis + Celery ───────────────────────────────────────────
# No changes needed unless you use an external Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1


# ── Storage ──────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50
PDF_MAX_PAGES=50


# ── Security ─────────────────────────────────────────────────
# Bearer token Caddy injects into every API request server-side.
# NEVER share this — it is a backend+Caddy secret only.
# Generate: openssl rand -hex 40
ADMIN_API_TOKEN=replace_with_32plus_random_chars                   # ← REQUIRED (min 32 chars)

# Used for future JWT signing — must be strong even if JWT not yet active.
# Generate: openssl rand -hex 40
JWT_SECRET=replace_with_32plus_random_chars                        # ← REQUIRED (min 32 chars)

# Not yet used for login but validated at startup — keep realistic values
ADMIN_EMAIL=admin@yourdomain.com                                   # ← REQUIRED
ADMIN_PASSWORD=replace_with_strong_admin_password                  # ← REQUIRED

# Must be HTTPS, no localhost — validated by backend at startup
CORS_ALLOWED_ORIGINS=https://workflow.example.com                  # ← REQUIRED (replace domain)


# ── OCR / AI ─────────────────────────────────────────────────
#
# ARCHITECTURE DES SERVICES IA
# ─────────────────────────────
# Phase 1 (disponible maintenant) :
#   • Mathpix      → transcription OCR, idéal pour les maths (LaTeX)
#   • Azure DI     → transcription OCR texte brut (Document Intelligence)
#   • OpenAI Vision → transcription complète page (gpt-4.1, JSON structuré)
#   • Fusion        → combine les 3 sources, détecte les divergences,
#                     flag needs_human_review si confiance < 0.6 ou zones illisibles
#
# Phase 2 (stubs — non encore implémentés) :
#   • grading_service  → notation automatique avec barème
#   • audit_service    → audit de traçabilité de la correction
#   Ces services utilisent OPENAI_GRADING_MODEL et OPENAI_AUDIT_MODEL
#   mais retournent {"status":"not_implemented"} pour l'instant.
#
# COÛT ESTIMATIF (ordre de grandeur, vérifier tarifs actuels)
# ────────────────────────────────────────────────────────────
# Mathpix      : ~0.004$/page  | 1000 pages gratuit/mois (plan Lite)
# Azure DI     : ~0.001$/page  | 500 pages gratuit/mois
# OpenAI gpt-4.1 vision : ~0.01-0.05$/page selon nb de tokens
# → Pour une copie de 4 pages avec les 3 services : ~0.06-0.24$
#
# SÉCURITÉ OCR
# ─────────────
# OCR_ENABLE_PAID_CALLS=false → aucun appel payant, les endpoints
#   retournent {"error":"paid_calls_disabled"} — VALEUR PAR DÉFAUT SÉCURISÉE
# OCR_MAX_PAGES_PER_JOB=3 → limite absolue sur POST /copies/{id}/ocr
# OCR_DEFAULT_IMAGE_TYPE=processed → utilise l'image prétraitée (meilleure qualité OCR)
#
# ACTIVATION PRUDENTE
# ────────────────────
# 1. Renseigner les clés ci-dessous
# 2. Vérifier via GET /api/integrations/status que "configured": true
# 3. Tester sur 1 page : POST /api/pages/{id}/ocr/mathpix?confirm_paid_call=true
# 4. Valider manuellement la transcription
# 5. Seulement ensuite, passer OCR_ENABLE_PAID_CALLS=true

# Interrupteur global — NE PAS mettre à true sans avoir validé les étapes ci-dessus
OCR_ENABLE_PAID_CALLS=false

# Limite absolue de pages par job OCR (protection coût)
OCR_MAX_PAGES_PER_JOB=3

# Type d'image envoyé à l'OCR : "processed" (prétraitée) ou "original"
OCR_DEFAULT_IMAGE_TYPE=processed


# ── Mathpix ──────────────────────────────────────────────────
# Spécialisé maths manuscrites → transcription texte + LaTeX
# Inscription : https://mathpix.com/  → Dashboard → API Keys
# Endpoint utilisé : POST https://api.mathpix.com/v3/text
# Formats retournés : text + latex_styled
# Laisser vide pour désactiver (retourne "missing_mathpix_keys")
MATHPIX_APP_ID=
MATHPIX_APP_KEY=


# ── Azure Document Intelligence ───────────────────────────────
# Transcription texte robuste — bon sur écriture mixte (texte + chiffres)
# Inscription : https://portal.azure.com/ → Create resource → Document Intelligence
# Modèle utilisé : prebuilt-read (api-version 2024-11-30)
# Endpoint format : https://<resource-name>.cognitiveservices.azure.com
# Clé : Azure Portal → Resource → Keys and Endpoint → KEY 1
# Laisser vide pour désactiver (retourne "missing_azure_document_intelligence_keys")
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=


# ── OpenAI ───────────────────────────────────────────────────
# Transcription vision complète + (phase 2) notation et audit
# Inscription : https://platform.openai.com/api-keys
# ⚠️ Vérifier billing limits sur https://platform.openai.com/settings/organization/limits
# Laisser vide pour désactiver (retourne "missing_openai_api_key")
OPENAI_API_KEY=

# Modèle utilisé pour la transcription de pages (Phase 1 — ACTIF)
# Utilisé dans : openai_vision_service.py → client.responses.create(model=...)
# gpt-4.1 = meilleur rapport qualité/coût pour vision haute résolution
OPENAI_VISION_MODEL=gpt-4.1

# Modèles pour notation et audit (Phase 2 — STUBS, pas encore appelés)
# Ces variables sont lues par config mais les services retournent not_implemented
OPENAI_GRADING_MODEL=gpt-4.1
OPENAI_AUDIT_MODEL=gpt-4.1


# ── RAG / Embeddings ─────────────────────────────────────────
# Production default: colocated RAG service over Docker internal networking.
RAG_PROVIDER=http
RAG_HTTP_BASE_URL=http://compose-ingestor-1:8001
# Remote development fallback:
# RAG_HTTP_BASE_URL=https://rag-api.nexusreussite.academy
RAG_HTTP_API_TOKEN=replace_with_rag_api_token                    # ← REQUIRED in production
RAG_HTTP_AUTH_HEADER=Authorization
RAG_HTTP_COLLECTION=rag_math_correction
RAG_HTTP_TIMEOUT_SECONDS=30.0

# Local fallback only when RAG_PROVIDER=pgvector.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
TEI_ENDPOINT=
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
