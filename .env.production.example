# Domain and TLS
APP_DOMAIN=workflow.example.com
CADDY_ACME_EMAIL=admin@example.com
CADDY_BASIC_AUTH_USER=admin
# Generate with: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'replace-me'
# In .env files used by Compose, escape dollar signs as $$.
CADDY_BASIC_AUTH_HASH=replace_with_caddy_bcrypt_hash

# App
APP_ENV=production
APP_NAME=math-correction-platform
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_API_BASE_URL=https://workflow.example.com/api
NEXT_PUBLIC_API_BASE_URL=https://workflow.example.com/api

# Database
POSTGRES_DB=correction_db
POSTGRES_USER=correction_user
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql+psycopg2://correction_user:replace_with_strong_database_password@postgres:5432/correction_db

# Redis + Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage and upload safety
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50
PDF_MAX_PAGES=50

# Security
ADMIN_API_TOKEN=replace_with_32plus_random_chars
JWT_SECRET=replace_with_32plus_random_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password
CORS_ALLOWED_ORIGINS=https://workflow.example.com

# OCR / AI
OCR_ENABLE_PAID_CALLS=false
OCR_MAX_PAGES_PER_JOB=3
OCR_DEFAULT_IMAGE_TYPE=processed
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_GRADING_MODEL=gpt-4.1
OPENAI_AUDIT_MODEL=gpt-4.1
