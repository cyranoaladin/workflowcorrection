# =========================
# App
# =========================
APP_ENV=development
APP_NAME=math-correction-platform
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_API_BASE_URL=http://localhost:8000

# =========================
# Database (PostgreSQL)
# =========================
POSTGRES_DB=correction_db
POSTGRES_USER=correction_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg2://correction_user:change_me@postgres:5432/correction_db

# =========================
# Redis + Celery
# =========================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =========================
# Storage
# =========================
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=50
PDF_MAX_PAGES=50

# Optional (future): MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=correction-files
MINIO_SECURE=false

# =========================
# OCR / IA (stubs ready)
# =========================
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_GRADING_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_AUDIT_MODEL=gpt-4.1-mini-2025-04-14

# OCR safety limits
OCR_MAX_PAGES_PER_JOB=3
# Absolute safety switch: if not true, NO paid OCR calls will be executed.
OCR_ENABLE_PAID_CALLS=false
# Default image type used by OCR endpoints when not specified.
OCR_DEFAULT_IMAGE_TYPE=processed

# =========================
# Embeddings / RAG
# =========================
# Provider: "openai" or "tei" (Hugging Face Text Embeddings Inference)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Only needed if EMBEDDING_PROVIDER=tei
TEI_ENDPOINT=
# Retrieval parameters
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
# Provider: "http" for the RAG service, "pgvector" for local fallback.
RAG_PROVIDER=http
# Production colocated on the Hetzner host uses Docker internal networking:
RAG_HTTP_BASE_URL=http://compose-ingestor-1:8001
# Remote development fallback:
# RAG_HTTP_BASE_URL=https://rag-api.nexusreussite.academy
RAG_HTTP_API_TOKEN=replace_me_in_production
RAG_HTTP_AUTH_HEADER=Authorization
RAG_HTTP_COLLECTION=rag_math_correction
RAG_HTTP_TIMEOUT_SECONDS=30.0

# =========================
# Security (future auth)
# =========================
JWT_SECRET=change_me_long_random_secret
ADMIN_API_TOKEN=change_me_32plus_random_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# =========================
# CORS (frontend local)
# =========================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
